<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Home screen widgets, filled from what the app last handed over
             (WorkbitWidgetsPlugin.java). -->
        <receiver
            android:name=".NextShiftWidget"
            android:exported="false"
            android:label="@string/widget_next_shift_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_shift_info" />
        </receiver>

        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <!-- The owner's and managers' widgets: who is in, what waits. -->
        <receiver
            android:name=".TeamNowWidget"
            android:exported="false"
            android:label="@string/widget_team_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_team_now_info" />
        </receiver>

        <receiver
            android:name=".PendingWidget"
            android:exported="false"
            android:label="@string/widget_pending_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pending_info" />
        </receiver>

        <!-- The second round of widgets (MoreWidgets.java). -->
        <receiver
            android:name=".MoreWidgets$Late"
            android:exported="false"
            android:label="@string/widget_late_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_late_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$Day"
            android:exported="false"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$WeekHours"
            android:exported="false"
            android:label="@string/widget_week_hours_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_hours_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$Board"
            android:exported="false"
            android:label="@string/widget_board_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$Mates"
            android:exported="false"
            android:label="@string/widget_mates_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mates_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$Month"
            android:exported="false"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month_info" />
        </receiver>

        <receiver
            android:name=".MoreWidgets$Tasks"
            android:exported="false"
            android:label="@string/widget_tasks_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

            <!-- CapacitorPasskey auto-configuration -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/capacitor_passkey_asset_statements" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Clock-in checks the employee is at the venue, so the web view needs to
         be allowed to ask for a position. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Shift reminders and clock-out warnings. Required from Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
