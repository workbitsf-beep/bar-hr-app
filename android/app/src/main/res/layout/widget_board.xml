<?xml version="1.0" encoding="utf-8"?>
<!-- "Plancia": MoreWidgets.java fills it in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/board_venue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#1B1830"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/board_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#57536B"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/board_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Per titolare e responsabili"
        android:textColor="#57536B"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/board_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_sky"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_rail_sky" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="IN SERVIZIO"
                    android:textColor="#0369A1"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/board_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:textColor="#1B1830"
                        android:textSize="26sp" />
                    <TextView
                        android:id="@+id/board_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#57536B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/board_in_names"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#57536B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_amber"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/board_late_rail"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_rail_amber" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="IN RITARDO"
                    android:textColor="#92400E"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/board_late"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:textColor="#1B1830"
                        android:textSize="26sp" />
                    
                </LinearLayout>

                <TextView
                    android:id="@+id/board_late_names"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#57536B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/widget_dot_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="DA APPROVARE"
                android:textColor="#047857"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/board_pending_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_count_pill"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:textColor="#047857"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/board_pending_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:text="Niente da approvare"
            android:textColor="#57536B"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/bp_row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ECE9F5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/bp_rail0"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_rail_green" />

                <TextView
                    android:id="@+id/bp_icon0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/bp_title0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1B1830"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/bp_when0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="#57536B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bp_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ECE9F5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/bp_rail1"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_rail_green" />

                <TextView
                    android:id="@+id/bp_icon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/bp_title1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1B1830"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/bp_when1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="#57536B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bp_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ECE9F5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/bp_rail2"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/widget_rail_green" />

                <TextView
                    android:id="@+id/bp_icon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/bp_title2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1B1830"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/bp_when2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="#57536B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
