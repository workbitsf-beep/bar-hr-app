<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.workbit.it</string>
	</array>
	<!-- The first is the app's own group, where everything it already kept
	     stays; the second is shared with the widgets. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)it.workbit.app</string>
		<string>$(AppIdentifierPrefix)it.workbit.shared</string>
	</array>
</dict>
</plist>
