generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  AMMINISTRAZIONE
  EMPLOYEE
}

/// The plan a venue is on. Pro adds departments; prices and account limits
/// are still being decided, so for now the super admin sets it by hand.
enum VenuePlan {
  BASE
  PRO
  /// Agreed with the customer: price, sites and people set by the super admin.
  CUSTOM
}

/// The three fixed departments of a venue, plus one the owner names, plus
/// Jolly: shifts anyone can work, wherever they are needed.
enum Department {
  BANCO
  CUCINA
  SALA
  CUSTOM
  JOLLY
  /// A company's sites: the same separation as a restaurant's departments,
  /// each with its own name, address and clock-in point (see Site).
  SEDE_1
  SEDE_2
  SEDE_3
  SEDE_4
  SEDE_5
  SEDE_6
  SEDE_7
  SEDE_8
  SEDE_9
  SEDE_10
  SEDE_11
  SEDE_12
}

/// One weekly calendar split by department, or one calendar per department
/// run by its lead. The shifts are the same either way.
enum DepartmentMode {
  UNIFIED
  SEPARATE
}

/// When a department's checklist is done: opening the day or closing it.
enum ChecklistMoment {
  OPENING
  CLOSING
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INACTIVE
}

enum PlanType {
  FREE
  TRIAL
  PAID
  LIFETIME
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InvoiceProvider {
  STRIPE
  EXTERNAL
}

/// Where a payment's e-invoice stands: data missing, made and waiting to be
/// sent, sent to the SDI, delivered, or turned down by the SDI.
enum FiscalState {
  NONE
  MISSING_DATA
  READY
  SENT
  DELIVERED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  FAILED
}

enum AppLanguage {
  it
  en
  es
  fr
}

enum AppTheme {
  LIGHT
  DARK
  SYSTEM
}

enum ActivityType {
  RESTAURANT
  COMPANY
}

enum ClockType {
  IN
  OUT
}

enum ClockFixKind {
  MISSED_IN
  MISSED_OUT
}

enum ClockFixStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskRepeatUnit {
  DAY
  WEEK
  MONTH
}

enum CourseKind {
  HACCP
  FIRE_SAFETY
  FIRST_AID
  OTHER
}

enum RoundingMode {
  UP
  DOWN
  NEAREST
}

enum RequestType {
  VACATION
  PERMISSION
  SHIFT_CHANGE
  SICKNESS
  OVERTIME
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CalendarClosureType {
  CLOSURE
  HOLIDAY
  VACATION
}

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_AND_CONDITIONS
  COOKIE_POLICY
  ACCOUNT_DELETION
  GEOLOCATION_NOTICE
  DPA
  SAAS_CONTRACT
  OTHER
}

model User {
  id                       String                  @id @default(uuid()) @db.Uuid
  email                    String                  @unique
  passwordHash             String
  /// A password asked for with "forgot password". It sits next to the real one
  /// until it is used or expires: replacing the real password on request let
  /// anyone who knew an address lock that person out, as often as they liked.
  tempPasswordHash         String?
  tempPasswordExpiresAt    DateTime?
  firstName                String
  lastName                 String
  role                     Role                    @default(EMPLOYEE)
  language                 AppLanguage             @default(it)
  theme                    AppTheme                @default(SYSTEM)
  mustChangePwd            Boolean                 @default(true)
  /// Set when the account has been closed but the person cannot be erased
  /// outright: attendance records identify the worker and the employer is
  /// obliged to keep them. Everything not needed for that record is cleared,
  /// the account can no longer be used, and the name stays on the register.
  retiredAt                DateTime?
  ownedBars                Bar[]                   @relation("BarOwner")
  barMemberships           EmployeeBar[]
  assignedShifts           Shift[]                 @relation("ShiftAssigned")
  createdShifts            Shift[]                 @relation("ShiftCreated")
  confirmedShifts          Shift[]                 @relation("ShiftConfirmed")
  shiftAssignments         ShiftAssignment[]
  timeLogs                 TimeLog[]
  createdTimeLogs          TimeLog[]               @relation("TimeLogCreatedBy")
  clockFixes               ClockFix[]              @relation("ClockFixRequester")
  reviewedClockFixes       ClockFix[]              @relation("ClockFixReviewer")
  tasksAssigned            Task[]                  @relation("TaskAssigned")
  tasksCreated             Task[]                  @relation("TaskCreated")
  tasksCompleted           Task[]                  @relation("TaskCompleted")
  taskCompletions          TaskCompletion[]
  notesAuthored            Note[]                  @relation("NoteAuthor")
  notesAbout               Note[]                  @relation("NoteAboutEmployee")
  noteReadReceipts         NoteReadReceipt[]
  documentsCreated         Document[]              @relation("DocumentCreated")
  documentsAssigned        Document[]              @relation("DocumentAssigned")
  documentsDeactivated     Document[]              @relation("DocumentDeactivated")
  shoppingListItemsCreated ShoppingListItem[]
  legalAcceptances         LegalAcceptance[]
  notificationsReceived    Notification[]          @relation("NotificationRecipient")
  scheduledNotifications   ScheduledNotification[]
  pushTokens               PushToken[]
  requests                 Request[]               @relation("RequestEmployee")
  reviewedReqs             Request[]               @relation("RequestReviewer")
  peerReviewedReqs         Request[]               @relation("RequestPeerReviewer")
  swapRequests             Request[]               @relation("RequestSwapEmployee")
  availabilities           Availability[]
  coursesAssigned          Course[]                @relation("CourseAssigned")
  courseCertificates       CourseCertificate[]     @relation("CertificateHolder")
  courseCertificatesAdded  CourseCertificate[]     @relation("CertificateAdder")
  coursesCreated           Course[]                @relation("CourseCreated")
  calendarClosuresCreated  CalendarClosure[]
  sessions                 Session[]
  webAuthnCredentials      WebAuthnCredential[]
  webAuthnChallenges       WebAuthnChallenge[]
  documentAccessTokens     DocumentAccessToken[]
  downloadTickets          DownloadTicket[]
  checklistRunsCompleted   ChecklistRun[]          @relation("ChecklistCompletedBy")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  homeLayouts              HomeLayout[]

  @@index([role])
  @@index([retiredAt])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  token       String    @unique
  userId      String    @db.Uuid
  activeBarId String?   @db.Uuid
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBar   Bar?      @relation(fields: [activeBarId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt, expiresAt])
}

model WebAuthnCredential {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  credentialId         String    @unique
  publicKey            Bytes
  counter              Int       @default(0)
  transports           String[]
  credentialDeviceType String?
  credentialBackedUp   Boolean   @default(false)
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUsedAt])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  challenge String   @unique
  type      String
  userId    String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challenge, type])
  @@index([userId, type])
  @@index([expiresAt])
}

model Bar {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  legalName               String?
  email                   String?
  phone                   String?
  addressLine1            String?
  city                    String?
  postalCode              String?
  vatNumber               String?
  latitude                Float
  longitude               Float
  radiusMeters            Int                      @default(10)
  roundingEnabled         Boolean                  @default(false)
  entryToleranceMin       Int                      @default(5)
  roundingStepMin         Int                      @default(15)
  exitToleranceMin        Int                      @default(13)
  activityType            ActivityType             @default(RESTAURANT)
  plan                    VenuePlan                @default(BASE)
  /// Base extras (Pro includes them all): departments, packs of five more
  /// people (at most two), and the venue's own logo and sign font.
  departmentsAddon        Boolean                  @default(false)
  extraSeatPacks          Int                      @default(0)
  brandingAddon           Boolean                  @default(false)
  /// Paid sites at 7,99 each. A company's are Site rows inside it (up to 3 on
  /// Base; on Pro on top of the 3 it includes, up to 6 in all). A
  /// restaurant's are branches - venues of their own linked by mainBarId -
  /// under the same name and tax details (up to 3 on Base; on Pro on top of
  /// the 2 it includes, up to 6 in all).
  extraSites              Int                      @default(0)
  /// The Su misura plan: what was agreed with the customer.
  customPriceCents        Int?
  customSeatLimit         Int?
  customSiteLimit         Int?
  customPlanNote          String?
  /// The venue's logo, already cropped square and small, and its sign font.
  logo                    Bytes?
  logoType                String?
  logoUpdatedAt           DateTime?
  signFont                String?
  departmentMode          DepartmentMode           @default(UNIFIED)
  /// The name of the fourth department; null while the owner has not added it.
  customDepartmentName    String?
  /// When and from where the owner declared, at public signup, to run a real
  /// business with this VAT number. Null for venues opened by hand.
  businessDeclaredAt      DateTime?
  businessDeclaredIp      String?
  ownerId                 String                   @db.Uuid
  owner                   User                     @relation("BarOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships             EmployeeBar[]
  settings                BarSettings?
  subscription            Subscription?
  billingProfile          BillingProfile?
  invoices                Invoice[]
  shifts                  Shift[]
  timeLogs                TimeLog[]
  clockFixes              ClockFix[]
  tasks                   Task[]
  notes                   Note[]
  requests                Request[]
  availabilities          Availability[]
  courses                 Course[]
  courseCertificates      CourseCertificate[]
  calendarClosures        CalendarClosure[]
  documents               Document[]
  shoppingListItems       ShoppingListItem[]
  checklists              Checklist[]
  sites                   Site[]
  /// A restaurant's branch (sede): a venue of its own - departments, calendar,
  /// clock-in point, people - billed with its main venue, whose plan and
  /// extras it shares (lib/venue-branches.ts).
  mainBarId               String?                  @db.Uuid
  mainBar                 Bar?                     @relation("BarBranches", fields: [mainBarId], references: [id], onDelete: Cascade)
  branches                Bar[]                    @relation("BarBranches")
  supplierInvoices        SupplierInvoice[]
  invoiceUploads          InvoiceUpload[]
  supplierCategories      SupplierCategory[]
  priceChecks             PriceCheck[]
  monthlyRevenues         MonthlyRevenue[]
  payrollRecipients       PayrollRecipient[]
  accountantAccesses      AccountantAccess[]
  payrollMonthAdjustments PayrollMonthAdjustment[]
  supplierPayments        SupplierPayment[]
  supplierPaymentRules    SupplierPaymentRule[]
  payrollDayOverrides     PayrollDayOverride[]
  payrollSends            PayrollSend[]
  legalAcceptances        LegalAcceptance[]
  notifications           Notification[]
  scheduledNotifications  ScheduledNotification[]
  sessions                Session[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  homeLayouts             HomeLayout[]

  @@index([ownerId])
  @@index([mainBarId])
  @@index([ownerId, createdAt])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  barId                  String             @unique @db.Uuid
  bar                    Bar                @relation(fields: [barId], references: [id], onDelete: Cascade)
  planType               PlanType           @default(PAID)
  billingInterval        BillingInterval?
  monthlyDiscountPercent Int                @default(0)
  status                 SubscriptionStatus @default(INACTIVE)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeDiscountCouponId String?
  currentPeriodEnd       DateTime?
  /// When the latest charge was issued and not yet confirmed paid. The venue
  /// keeps working for seven days from here, then it stops until the payment
  /// arrives. Cleared when Stripe reports the invoice paid.
  paymentDueSince        DateTime?
  trialEndsAt            DateTime?
  /// The owner turned the subscription off: Stripe stops renewing it, and the
  /// venue keeps working until currentPeriodEnd (or trialEndsAt), already paid.
  cancelAtPeriodEnd      Boolean            @default(false)
  // Quando e partito l'avviso "la prova scade fra tre giorni". Serve solo a
  // non mandarlo due volte: il lavoro notturno gira ogni giorno e senza
  // questo segno riscriverebbe alla stessa persona ogni mattina.
  trialEndingNoticeAt    DateTime?
  /// When the owner, inside the installed app, was last emailed the link to
  /// reactivate: the app itself cannot point at paying (Apple), so the email
  /// does. Once a day at most.
  reactivationEmailAt    DateTime?
  invoices               Invoice[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
}

model BillingProfile {
  id                String    @id @default(uuid()) @db.Uuid
  barId             String    @unique @db.Uuid
  businessName      String?
  vatNumber         String?
  taxCode           String?
  recipientCode     String?
  certifiedEmail    String?
  billingEmail      String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  province          String?
  postalCode        String?
  countryCode       String    @default("IT")
  stripeTaxId       String?
  fiscalProviderRef String?
  invoicingEnabled  Boolean   @default(false)
  validatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bar               Bar       @relation(fields: [barId], references: [id], onDelete: Cascade)

  @@index([vatNumber])
  @@index([taxCode])
}

model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  barId            String          @db.Uuid
  subscriptionId   String?         @db.Uuid
  provider         InvoiceProvider @default(STRIPE)
  externalId       String
  externalNumber   String?
  status           InvoiceStatus   @default(DRAFT)
  currency         String          @default("eur")
  subtotalAmount   Int             @default(0)
  taxAmount        Int             @default(0)
  totalAmount      Int             @default(0)
  paidAmount       Int             @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  hostedUrl        String?
  pdfUrl           String?
  fiscalDocumentId String?
  fiscalError      String?
  /// The Italian e-invoice (FatturaPA) made from this payment: numbered
  /// 2026/1, 2026/2... per year, kept as the XML the SDI receives.
  fiscalState      FiscalState     @default(NONE)
  fiscalYear       Int?
  fiscalSequence   Int?
  fiscalNumber     String?
  fiscalFileName   String?
  fiscalXml        String?
  /// The lines as Stripe billed them, kept to make the invoice later.
  fiscalLines      Json?
  /// When it was handed to the SDI through Openapi (fiscalDocumentId holds
  /// Openapi's uuid for it).
  fiscalSentAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bar              Bar             @relation(fields: [barId], references: [id], onDelete: Cascade)
  subscription     Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@unique([fiscalYear, fiscalSequence])
  @@index([barId, issuedAt])
  @@index([subscriptionId])
  @@index([status, dueAt])
}

model BarSettings {
  id                     String        @id @default(uuid()) @db.Uuid
  barId                  String        @unique @db.Uuid
  bar                    Bar           @relation(fields: [barId], references: [id], onDelete: Cascade)
  gpsLatitude            Float?
  gpsLongitude           Float?
  gpsRadius              Int?
  /// The owner chose "Imposto dopo" for the clock-in point during setup:
  /// setup is complete without it, and the home page reminds them until set.
  gpsPostponedAt         DateTime?
  companyShiftsEnabled   Boolean?
  timeTrackingEnabled    Boolean       @default(true)
  shiftsEnabled          Boolean       @default(true)
  requestsEnabled        Boolean       @default(true)
  availabilityEnabled    Boolean       @default(true)
  overtimeEnabled        Boolean       @default(true)
  tasksEnabled           Boolean       @default(true)
  noticeBoardEnabled     Boolean       @default(true)
  coursesEnabled         Boolean       @default(true)
  /// Days before a certificate expires that the owner and the person are
  /// first reminded, so there is time to book the course again.
  courseReminderDays     Int           @default(60)
  documentsEnabled       Boolean       @default(true)
  reportsEnabled         Boolean       @default(true)
  shoppingListEnabled    Boolean       @default(true)
  roundingEnabled        Boolean       @default(false)
  roundingMinutes        Int?
  roundingMode           RoundingMode?
  morningStartTime       String?
  morningEndTime         String?
  afternoonStartTime     String?
  afternoonEndTime       String?
  eveningStartTime       String?
  eveningEndTime         String?
  standardShiftPresets   Json?
  /// Where the month's attendance for the consultant takes its hours from:
  /// AUTO (clock-ins when the venue clocks in, otherwise the shifts), CLOCK
  /// or SHIFTS. From the shifts, a break is taken off every shift at least
  /// payrollBreakAfterHours long.
  payrollSource          String        @default("AUTO")
  payrollBreakMinutes    Int?
  payrollBreakAfterHours Float?
  /// Whether hours past the weekly contract count as overtime in Presenze and
  /// the consultant's file. Null: no for a bar or restaurant, where a shift
  /// that runs long is still ordinary hours; yes for a company.
  payrollOvertime        Boolean?
  /// Supplier invoices received through Openapi (codice destinatario
  /// USAL8PV): OFF, WAITING (registered, the owner still has to set the code
  /// at the Agenzia delle Entrate), ACTIVE once the first invoice arrived.
  invoiceInboxStatus     String        @default("OFF")
  invoiceInboxFiscalId   String?
  invoiceInboxSince      DateTime?
  invoiceInboxSyncedAt   DateTime?
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  barId     String?  @db.Uuid
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  bar       Bar?     @relation(fields: [barId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([barId, createdAt])
  @@index([type, createdAt])
}

model ScheduledNotification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  barId      String?   @db.Uuid
  shiftId    String?   @db.Uuid
  type       String
  title      String
  message    String
  actionUrl  String?
  sendAt     DateTime
  sentAt     DateTime?
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bar        Bar?      @relation(fields: [barId], references: [id], onDelete: Cascade)
  shift      Shift?    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, type, actionUrl])
  @@index([sendAt, sentAt, canceledAt])
  @@index([userId, sendAt])
  @@index([barId, sendAt])
  @@index([shiftId])
  @@index([type, sendAt])
}

model PushToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @unique
  platform   String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model EmployeeBar {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  barId               String       @db.Uuid
  role                Role         @default(EMPLOYEE)
  hourlyRate          Decimal?     @db.Decimal(10, 2)
  isActive            Boolean      @default(true)
  hiredAt             DateTime     @default(now())
  endedAt             DateTime?
  /// Pro only: where this person works, and where they can lend a hand.
  department          Department?
  helpsIn             Department[] @default([])
  /// Runs the shifts, leave and swaps of their department. Kept for history:
  /// since 13 Oct 2026 a lead is a Responsabile of their department.
  isDepartmentLead    Boolean      @default(false)
  /// Responsabile / Amministrazione: what the owner lets them do, as keys
  /// (shifts, requests, timelogs, notes, checklists, people, documents,
  /// reports). Ignored for the owner and for employees.
  permissions         String[]     @default([])
  /// Where those permissions apply: departments (a restaurant's Sala) or
  /// sites (a company's SEDE_2, SEDE_3); empty means the whole venue or company.
  managesDepartments  Department[] @default([])
  /// How the labour consultant knows this person: matricola or codice
  /// fiscale, written on the monthly export.
  payrollCode         String?
  /// Contract hours a week: above them a day's hours are overtime on the
  /// consultant's export. Null when the owner has not said.
  contractWeeklyHours Float?
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bar                 Bar          @relation(fields: [barId], references: [id], onDelete: Cascade)

  @@unique([userId, barId])
  @@index([userId])
  @@index([barId])
  @@index([barId, isActive])
  @@index([barId, role, isActive])
  @@index([userId, isActive])
}

model Shift {
  id                     String                  @id @default(uuid()) @db.Uuid
  title                  String?
  startTime              DateTime
  endTime                DateTime
  isOnCall               Boolean                 @default(false)
  /// Pro only: the department the shift belongs to.
  department             Department?
  barId                  String                  @db.Uuid
  bar                    Bar                     @relation(fields: [barId], references: [id], onDelete: Cascade)
  assignedToId           String?                 @db.Uuid
  assignedTo             User?                   @relation("ShiftAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById            String                  @db.Uuid
  createdBy              User                    @relation("ShiftCreated", fields: [createdById], references: [id], onDelete: Cascade)
  confirmedAt            DateTime?
  confirmedById          String?                 @db.Uuid
  confirmedBy            User?                   @relation("ShiftConfirmed", fields: [confirmedById], references: [id], onDelete: SetNull)
  assignments            ShiftAssignment[]
  timeLogs               TimeLog[]
  clockFixes             ClockFix[]
  requests               Request[]               @relation("RequestShift")
  swapRequests           Request[]               @relation("RequestSwapShift")
  scheduledNotifications ScheduledNotification[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([barId, assignedToId])
  @@index([barId, startTime])
  @@index([barId, endTime])
  @@index([barId, department, startTime])
  @@index([barId, confirmedAt])
  @@index([startTime])
  @@index([createdById])
  @@index([confirmedById])
}

model ShiftAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  shiftId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId, shiftId])
}

model TimeLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  barId        String    @db.Uuid
  bar          Bar       @relation(fields: [barId], references: [id], onDelete: Cascade)
  shiftId      String?   @db.Uuid
  shift        Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdById  String?   @db.Uuid
  createdBy    User?     @relation("TimeLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  type         ClockType
  timestamp    DateTime  @default(now())
  latitude     Float?
  longitude    Float?
  isManual     Boolean   @default(false)
  autoClockOut Boolean   @default(false)
  /// Stamped on the phone without network and sent when it came back: the
  /// time is the phone's, so the owner sees it marked "senza rete".
  offline      Boolean   @default(false)
  note         String?

  @@index([barId, userId, timestamp])
  @@index([barId, userId, type, timestamp])
  @@index([shiftId])
  @@index([userId, timestamp])
}

/// One of a company's sites (Pro or the Sedi extra). Its slot is the value
/// the shifts, people, notes and lists carry, as departments do for a
/// restaurant; the name, address and clock-in point live here.
model Site {
  id        String     @id @default(uuid()) @db.Uuid
  barId     String     @db.Uuid
  bar       Bar        @relation(fields: [barId], references: [id], onDelete: Cascade)
  slot      Department
  /// The company's own place: always there, never paid for, never removed.
  isMain    Boolean    @default(false)
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([barId, slot])
}

/// A clock-in or clock-out someone forgot. The person says when they really
/// came in or left; nothing is stamped until the owner or a manager approves
/// it, at that time or at one they choose.
model ClockFix {
  id             String         @id @default(uuid()) @db.Uuid
  barId          String         @db.Uuid
  bar            Bar            @relation(fields: [barId], references: [id], onDelete: Cascade)
  userId         String         @db.Uuid
  user           User           @relation("ClockFixRequester", fields: [userId], references: [id], onDelete: Cascade)
  shiftId        String?        @db.Uuid
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  /// The entry left open, for a forgotten exit.
  clockInId      String?        @db.Uuid
  kind           ClockFixKind
  status         ClockFixStatus @default(PENDING)
  requestedInAt  DateTime?
  requestedOutAt DateTime?
  resolvedInAt   DateTime?
  resolvedOutAt  DateTime?
  reviewedById   String?        @db.Uuid
  reviewedBy     User?          @relation("ClockFixReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([barId, status])
  @@index([userId, status])
  @@index([shiftId])
}

model Task {
  id                   String           @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  status               TaskStatus       @default(TODO)
  dueDate              DateTime
  isUrgent             Boolean          @default(false)
  requiresConfirmation Boolean          @default(true)
  // A note that comes back by itself: "controllo estintori ogni 6 mesi". Only
  // the newest occurrence of a series carries the rule, so a series can never
  // produce two pending notes for the same check.
  repeatEvery          Int?
  repeatUnit           TaskRepeatUnit?
  /// Pro: the department the note is for; null when it is for everyone.
  department           Department?
  assignedToAll        Boolean          @default(false)
  barId                String           @db.Uuid
  bar                  Bar              @relation(fields: [barId], references: [id], onDelete: Cascade)
  assignedToId         String?          @db.Uuid
  assignedTo           User?            @relation("TaskAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById          String           @db.Uuid
  createdBy            User             @relation("TaskCreated", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt          DateTime?
  completedById        String?          @db.Uuid
  completedBy          User?            @relation("TaskCompleted", fields: [completedById], references: [id], onDelete: SetNull)
  completions          TaskCompletion[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([barId, dueDate])
  @@index([barId, status, dueDate])
  @@index([barId, assignedToId, status])
  @@index([assignedToId])
  @@index([completedById])
}

model TaskCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  userId      String   @db.Uuid
  completedAt DateTime @default(now())
  note        String?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Note {
  id                   String            @id @default(uuid()) @db.Uuid
  barId                String            @db.Uuid
  authorId             String            @db.Uuid
  employeeId           String?           @db.Uuid
  content              String
  isPinned             Boolean           @default(false)
  requiresConfirmation Boolean           @default(false)
  activityDate         DateTime?
  bar                  Bar               @relation(fields: [barId], references: [id], onDelete: Cascade)
  author               User              @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  employee             User?             @relation("NoteAboutEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  readReceipts         NoteReadReceipt[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([barId, createdAt])
  @@index([barId, activityDate])
  @@index([barId, isPinned, createdAt])
  @@index([employeeId])
}

model NoteReadReceipt {
  id     String   @id @default(uuid()) @db.Uuid
  noteId String   @db.Uuid
  userId String   @db.Uuid
  readAt DateTime @default(now())
  note   Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId, readAt])
  @@index([noteId, readAt])
}

model Availability {
  id        String   @id @default(uuid()) @db.Uuid
  barId     String   @db.Uuid
  userId    String   @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bar       Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([barId, startsAt])
  @@index([barId, endsAt])
  @@index([barId, userId, startsAt])
  @@index([userId, startsAt])
}

model Request {
  id               String         @id @default(uuid()) @db.Uuid
  barId            String         @db.Uuid
  employeeId       String         @db.Uuid
  shiftId          String?        @db.Uuid
  swapShiftId      String?        @db.Uuid
  reviewedById     String?        @db.Uuid
  swapWithUserId   String?        @db.Uuid
  peerReviewedById String?        @db.Uuid
  type             RequestType
  status           RequestStatus  @default(PENDING)
  peerStatus       RequestStatus?
  ownerStatus      RequestStatus?
  reason           String?
  certificateCode  String?
  startsAt         DateTime?
  endsAt           DateTime?
  peerReviewedAt   DateTime?
  reviewedAt       DateTime?
  appliedAt        DateTime?
  bar              Bar            @relation(fields: [barId], references: [id], onDelete: Cascade)
  employee         User           @relation("RequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  shift            Shift?         @relation("RequestShift", fields: [shiftId], references: [id], onDelete: SetNull)
  swapShift        Shift?         @relation("RequestSwapShift", fields: [swapShiftId], references: [id], onDelete: SetNull)
  reviewedBy       User?          @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  swapWith         User?          @relation("RequestSwapEmployee", fields: [swapWithUserId], references: [id], onDelete: SetNull)
  peerReviewedBy   User?          @relation("RequestPeerReviewer", fields: [peerReviewedById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([barId, status])
  @@index([barId, status, createdAt])
  @@index([barId, type, status])
  @@index([barId, startsAt])
  @@index([employeeId, createdAt])
  @@index([swapShiftId])
  @@index([swapWithUserId])
}

model Course {
  certificates  CourseCertificate[]
  id            String              @id @default(uuid()) @db.Uuid
  barId         String              @db.Uuid
  title         String
  description   String?
  // A course in a venue is nearly always a deadline: HACCP lasts three years,
  // fire safety five. The kind knows how long, so nobody has to.
  kind          CourseKind          @default(OTHER)
  expiresAt     DateTime?
  startsAt      DateTime
  endsAt        DateTime
  location      String?
  assignedToAll Boolean             @default(false)
  assignedToId  String?             @db.Uuid
  createdById   String              @db.Uuid
  bar           Bar                 @relation(fields: [barId], references: [id], onDelete: Cascade)
  assignedTo    User?               @relation("CourseAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("CourseCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([barId, startsAt])
  @@index([barId, assignedToId, startsAt])
  @@index([assignedToId, startsAt])
  @@index([createdById])
}

model CalendarClosure {
  id          String              @id @default(uuid()) @db.Uuid
  barId       String              @db.Uuid
  title       String
  type        CalendarClosureType @default(CLOSURE)
  startsAt    DateTime
  endsAt      DateTime
  createdById String              @db.Uuid
  bar         Bar                 @relation(fields: [barId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([barId, startsAt])
  @@index([barId, endsAt])
  @@index([createdById])
}

model LegalDocument {
  id            String            @id @default(uuid()) @db.Uuid
  title         String
  type          LegalDocumentType
  version       String
  revision      Int               @default(1)
  content       String?
  fileUrl       String?
  fileName      String?
  fileMimeType  String?
  fileSize      Int?
  fileContent   Bytes?
  /// The PDF was made by Workbit from `content` (lib/legal-pdf.ts) and is
  /// made again when the text changes; false for a PDF uploaded by hand.
  fileGenerated Boolean           @default(false)
  isActive      Boolean           @default(true)
  isRequired    Boolean           @default(true)
  acceptances   LegalAcceptance[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([type, isActive])
  @@index([isActive, isRequired])
  @@index([updatedAt])
}

model LegalAcceptance {
  id         String        @id @default(uuid()) @db.Uuid
  documentId String        @db.Uuid
  userId     String        @db.Uuid
  barId      String?       @db.Uuid
  version    String
  revision   Int           @default(1)
  acceptedAt DateTime      @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bar        Bar?          @relation(fields: [barId], references: [id], onDelete: SetNull)

  @@unique([documentId, userId, version, revision])
  @@index([userId, acceptedAt])
  @@index([barId, acceptedAt])
  @@index([documentId, version, revision])
}

model Document {
  id              String                @id @default(uuid()) @db.Uuid
  barId           String                @db.Uuid
  title           String
  description     String?
  fileName        String
  mimeType        String
  fileSize        Int
  content         Bytes
  assignedToAll   Boolean               @default(true)
  assignedToId    String?               @db.Uuid
  createdById     String                @db.Uuid
  isActive        Boolean               @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?               @db.Uuid
  bar             Bar                   @relation(fields: [barId], references: [id], onDelete: Cascade)
  assignedTo      User?                 @relation("DocumentAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User                  @relation("DocumentCreated", fields: [createdById], references: [id], onDelete: Cascade)
  deactivatedBy   User?                 @relation("DocumentDeactivated", fields: [deactivatedById], references: [id], onDelete: SetNull)
  accessTokens    DocumentAccessToken[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([barId, createdAt])
  @@index([barId, isActive, createdAt])
  @@index([assignedToId, isActive])
  @@index([deactivatedById])
}

/// A short-lived permission to fetch one document without a session cookie.
///
/// The installed app cannot show a file itself, so it hands the address to the
/// phone's browser — a separate application that does not carry the Workbit
/// session. The token travels in that address instead, is tied to one document
/// and one reader, and expires within minutes.
model DocumentAccessToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  documentId String   @db.Uuid
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([documentId])
  @@index([userId])
}

/// The company details the legal documents are written from.
///
/// One row for the whole installation. The fields live in a JSON blob on
/// purpose: they are a form, not something queried, and they will grow as the
/// documents do — a column each would mean a migration for every new clause.
model CompanyProfile {
  id        String   @id @default("singleton")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A file already produced and authorised, waiting to be collected once.
///
/// The app's web view cannot save a file handed to it in memory, so a report
/// has to become a real address the phone's browser can fetch. The check
/// happened when the file was made: the ticket is short-lived, single use, and
/// carries no permission of its own.
model DownloadTicket {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  fileName  String
  mimeType  String
  content   Bytes
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model ShoppingListItem {
  id          String      @id @default(uuid()) @db.Uuid
  barId       String      @db.Uuid
  name        String
  quantity    String?
  /// Pro: the department the item is for; null on Base, or for the whole venue.
  department  Department?
  createdById String      @db.Uuid
  bar         Bar         @relation(fields: [barId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([barId, createdAt])
}

/// Pro: what a department checks when it opens or closes - "frigo controllato",
/// "cassa contata". One list per department and moment, written by the owner.
model Checklist {
  id         String          @id @default(uuid()) @db.Uuid
  barId      String          @db.Uuid
  department Department
  moment     ChecklistMoment
  items      String[]
  bar        Bar             @relation(fields: [barId], references: [id], onDelete: Cascade)
  runs       ChecklistRun[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([barId, department, moment])
}

/// One day of a checklist: which items are ticked, and who finished it when.
model ChecklistRun {
  id            String    @id @default(uuid()) @db.Uuid
  checklistId   String    @db.Uuid
  /// The venue's calendar day, at UTC midnight (see lib/day-key.ts).
  day           DateTime
  doneItems     String[]
  completedById String?   @db.Uuid
  completedAt   DateTime?
  checklist     Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime  @updatedAt

  @@unique([checklistId, day])
}

/// Workbit's own books, kept by the super admin in the console (Denaro → Costi
/// e debiti): what the business spends, what it owes, and income from outside
/// the subscriptions. Subscription income comes from the invoices.
enum LedgerKind {
  /// A running cost, every month or every year (server, accountant).
  COST
  /// A one-off expense on a date.
  EXPENSE
  /// Money owed: a loan paid in installments, or a bill due on a date.
  DEBT
  /// Income outside the subscriptions, every month, every year or once.
  INCOME
}

enum LedgerPeriod {
  MONTHLY
  YEARLY
  ONCE
}

model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  kind             LedgerKind
  name             String
  note             String?
  /// Cost or income: per period. Expense: the amount. Debt: the total owed.
  amountCents      Int
  period           LedgerPeriod    @default(MONTHLY)
  /// When it starts; for an expense, its date.
  startsOn         DateTime
  /// A running cost or income that stopped.
  endsOn           DateTime?
  /// A loan's monthly installment.
  installmentCents Int?
  /// A bill due on one date.
  dueOn            DateTime?
  payments         LedgerPayment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([kind])
}

model LedgerPayment {
  id          String      @id @default(uuid()) @db.Uuid
  entryId     String      @db.Uuid
  entry       LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  amountCents Int
  paidOn      DateTime
  createdAt   DateTime    @default(now())

  @@index([entryId])
  @@index([paidOn])
}

/// A supplier's invoice to the venue, read from its FatturaPA XML - uploaded
/// in the monthly zip from the cassetto fiscale, or received through Openapi.
model SupplierInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  barId           String                @db.Uuid
  bar             Bar                   @relation(fields: [barId], references: [id], onDelete: Cascade)
  /// "upload" or "openapi".
  source          String
  uploadId        String?               @db.Uuid
  upload          InvoiceUpload?        @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  openapiUuid     String?
  /// Supplier, number, date and type: the same invoice uploaded twice, or
  /// uploaded and also received, is kept once.
  dedupeKey       String
  /// TD01 invoice, TD04 credit note (its amounts are stored negative)...
  docType         String
  supplierName    String
  supplierVat     String?
  supplierTaxCode String?
  number          String
  /// The invoice date, at UTC midnight.
  issueDate       DateTime
  currency        String                @default("EUR")
  totalCents      Int
  taxableCents    Int
  vatCents        Int
  /// The original XML, gzip-compressed, attachments removed.
  xmlGz           Bytes?
  lines           SupplierInvoiceLine[]
  payments        SupplierPayment[]
  /// When the payment terms were read from the XML (null: not yet, for invoices from before).
  paymentsReadAt  DateTime?
  createdAt       DateTime              @default(now())

  @@unique([barId, dedupeKey])
  @@index([barId, issueDate])
  @@index([barId, supplierVat])
}

model SupplierInvoiceLine {
  id             String          @id @default(uuid()) @db.Uuid
  invoiceId      String          @db.Uuid
  invoice        SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  barId          String          @db.Uuid
  lineNo         Int
  description    String
  code           String?
  quantity       Float?
  unit           String?
  unitPrice      Float?
  /// The line's amount without VAT, negative on a credit note.
  totalCents     Int
  vatRate        Float?
  /// A key of lib/costs/categories.ts; "da_classificare" until it is known.
  category       String          @default("da_classificare")
  /// rule, ai, user, supplier.
  categorySource String?
  /// The same product across invoices and suppliers ("peroni-33cl"), with a
  /// readable name, the base unit (kg, l, pz, kwh, smc) and how much of it
  /// the line holds.
  productKey     String?
  productLabel   String?
  baseUnit       String?
  baseQty        Float?

  @@index([invoiceId])
  @@index([barId, category])
  @@index([barId, productKey])
}

model InvoiceUpload {
  id           String            @id @default(uuid()) @db.Uuid
  barId        String            @db.Uuid
  bar          Bar               @relation(fields: [barId], references: [id], onDelete: Cascade)
  fileName     String
  uploadedById String?           @db.Uuid
  found        Int               @default(0)
  imported     Int               @default(0)
  duplicates   Int               @default(0)
  skipped      Int               @default(0)
  failed       Int               @default(0)
  /// What was skipped and why, for the owner to read.
  notes        Json?
  invoices     SupplierInvoice[]
  createdAt    DateTime          @default(now())

  @@index([barId, createdAt])
}

/// What a line of a supplier's invoice is: learnt once - by the rules, by
/// Claude, or by the owner correcting it - and reused on every later
/// invoice. Scope "" is shared by every venue; a venue's own corrections
/// carry its id and win.
model SupplierProductMap {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String   @default("")
  key          String
  category     String
  productKey   String?
  productLabel String?
  baseUnit     String?
  /// Base units in one invoiced unit: a "CT" of 24 Peroni 33 cl is 7.92 l.
  unitsPerItem Float?
  source       String
  updatedAt    DateTime @updatedAt

  @@unique([scope, key])
}

/// The owner's word on a whole supplier: "Enel is Energia".
model SupplierCategory {
  id          String   @id @default(uuid()) @db.Uuid
  barId       String   @db.Uuid
  bar         Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  supplierKey String
  category    String
  updatedAt   DateTime @updatedAt

  @@unique([barId, supplierKey])
}

/// One search of the web for what a product costs elsewhere.
model PriceCheck {
  id            String   @id @default(uuid()) @db.Uuid
  barId         String   @db.Uuid
  bar           Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  productKey    String
  productLabel  String
  baseUnit      String?
  ourUnitPrice  Float?
  /// Offers found: title, seller, url, price, unit price, conditions.
  offers        Json
  bestUnitPrice Float?
  summary       String?
  checkedAt     DateTime @default(now())

  @@index([barId, productKey, checkedAt])
}

/// What the venue took in a month, typed by the owner: costs read against it.
model MonthlyRevenue {
  id          String   @id @default(uuid()) @db.Uuid
  barId       String   @db.Uuid
  bar         Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  /// "2026-10"
  month       String
  amountCents Int
  updatedAt   DateTime @updatedAt

  @@unique([barId, month])
}

/// Who the month's attendance goes to - the labour consultant, the
/// accountant - each with the file the way their software wants it.
model PayrollRecipient {
  id            String        @id @default(uuid()) @db.Uuid
  barId         String        @db.Uuid
  bar           Bar           @relation(fields: [barId], references: [id], onDelete: Cascade)
  /// consulente, commercialista or altro
  role          String        @default("consulente")
  name          String
  email         String
  cc            String?
  /// The file's layout, columns, codes and formats (lib/payroll/template.ts).
  template      Json?
  /// The email's text, with {nome}, {mese}, {locale}, {persone}, {firma}.
  message       String?
  /// Day of the month the owner is reminded to check and send.
  sendDay       Int?
  /// "2026-10": the month already reminded about.
  remindedMonth String?
  sends         PayrollSend[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([barId])
}

/// A day corrected at review: replaces that day's hours in the files only.
/// The clock-ins and the shifts stay as they were.
model PayrollDayOverride {
  id          String   @id @default(uuid()) @db.Uuid
  barId       String   @db.Uuid
  bar         Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  /// UTC midnight of the day.
  date        DateTime
  /// [{ kind, hours, days }]
  entries     Json
  note        String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([barId, userId, date])
  @@index([barId, date])
}

/// The owner's totals for a person's month, set before sending: they
/// replace the computed ones in the files only (lib/payroll/adjust.ts).
/// The clock-ins and the shifts stay as they were.
model PayrollMonthAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  barId       String   @db.Uuid
  bar         Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  /// "2026-10"
  month       String
  /// { ordinary: { hours }, holiday: { days, hours }, ... }
  totals      Json
  note        String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([barId, userId, month])
  @@index([barId, month])
}

/// A month's files handed to a recipient: opened in the phone's mail, or
/// sent by Workbit.
model PayrollSend {
  id          String           @id @default(uuid()) @db.Uuid
  barId       String           @db.Uuid
  bar         Bar              @relation(fields: [barId], references: [id], onDelete: Cascade)
  recipientId String           @db.Uuid
  recipient   PayrollRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  /// "2026-10"
  month       String
  /// mail_app, share, mailto or workbit
  channel     String
  sentById    String?          @db.Uuid
  sentAt      DateTime         @default(now())

  @@index([barId, month])
  @@index([recipientId, month])
}

/// One person's course, done: when, until when it is valid, and the
/// certificate. The scheduled Course is the event; this is what it left.
/// A newer one of the same kind for the same person takes its place.
model CourseCertificate {
  id            String     @id @default(uuid()) @db.Uuid
  barId         String     @db.Uuid
  bar           Bar        @relation(fields: [barId], references: [id], onDelete: Cascade)
  userId        String     @db.Uuid
  user          User       @relation("CertificateHolder", fields: [userId], references: [id], onDelete: Cascade)
  kind          CourseKind @default(OTHER)
  title         String
  /// The scheduled course it came from, when there was one.
  courseId      String?    @db.Uuid
  course        Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// UTC midnight of the day the course was done.
  completedAt   DateTime
  /// UTC midnight of the last valid day; none for a course that does not expire.
  expiresAt     DateTime?
  fileName      String?
  mimeType      String?
  fileSize      Int?
  content       Bytes?
  addedById     String?    @db.Uuid
  addedBy       User?      @relation("CertificateAdder", fields: [addedById], references: [id], onDelete: SetNull)
  /// 0 none sent, 1 the first notice, 2 a month before, 3 a week before, 4 expired.
  reminderStage Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([barId, expiresAt])
  @@index([barId, userId, kind])
  @@index([courseId])
}

/// The blocks a person keeps on Oggi, in order (lib/home-blocks.ts). No row
/// means the base layout.
model HomeLayout {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  barId     String   @db.Uuid
  blocks    String[] @default([])
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bar       Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)

  @@unique([userId, barId])
  @@index([barId])
}

/// The venue's accountant (commercialista), by email: one email reaches
/// every venue whose owner added it, and downloads that venue's supplier
/// invoices month by month. Nothing else of the venue is visible to it.
model AccountantAccess {
  id        String   @id @default(uuid()) @db.Uuid
  barId     String   @db.Uuid
  bar       Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  /// Lowercase.
  email     String
  name      String?
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([barId, email])
  @@index([email])
}

/// A six-digit code mailed to an accountant to sign in; kept hashed.
model AccountantLoginCode {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// An accountant signed in on a browser; the cookie holds the token, this
/// row its hash.
model AccountantSession {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Per accountant email: the last month they were told is ready.
model AccountantNotice {
  email         String   @id
  notifiedMonth String
  updatedAt     DateTime @updatedAt
}

/// One instalment of a supplier invoice, from its DatiPagamento: when, how
/// much, how (MP05 bonifico, MP12 RiBa...), to which IBAN. Whether it is paid
/// is read from the method (card, cash, direct debit) or told by the owner.
model SupplierPayment {
  id          String          @id @default(uuid()) @db.Uuid
  barId       String          @db.Uuid
  bar         Bar             @relation(fields: [barId], references: [id], onDelete: Cascade)
  invoiceId   String          @db.Uuid
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// UTC midnight of the due day.
  dueDate     DateTime
  amountCents Int
  /// MP01..MP23, null when the invoice does not say.
  method      String?
  iban        String?
  /// The owner's word: PAID or NOT_PAID; null until they say.
  state       String?
  paidAt      DateTime?
  /// The reminder before the due day, and the "did you pay?" after it.
  remindedAt  DateTime?
  askedAt     DateTime?
  createdAt   DateTime        @default(now())

  @@index([barId, dueDate])
  @@index([invoiceId])
}

/// "This supplier I always pay on the spot": its invoices count as paid.
model SupplierPaymentRule {
  id           String   @id @default(uuid()) @db.Uuid
  barId        String   @db.Uuid
  bar          Bar      @relation(fields: [barId], references: [id], onDelete: Cascade)
  supplierKey  String
  supplierName String
  createdAt    DateTime @default(now())

  @@unique([barId, supplierKey])
}
